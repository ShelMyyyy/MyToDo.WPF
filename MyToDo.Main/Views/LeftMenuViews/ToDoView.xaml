<UserControl
    x:Class="MyToDo.Main.Views.LeftMenuViews.ToDoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MyToDo.Main.Views.LeftMenuViews"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <md:DialogHost>
        <md:DrawerHost IsRightDrawerOpen="{Binding IsChecked}">
            <md:DrawerHost.RightDrawerContent>
                <StackPanel
                    Width="200"
                    Orientation="Vertical">
                    <TextBlock
                        Text="待办事项"
                        Margin="10"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White" />
                    <TextBox
                        Margin="10"
                        md:HintAssist.Hint="请输入待办事项标题"
                        Foreground="White" />
                    <RichTextBox
                        Height="100"
                        Margin="10"
                        md:HintAssist.Hint="请输入待办内容"
                        Foreground="White" />
                    <Button
                        Content="添加"
                        Command="{Binding ConfirmAddTodoItemCommand}"
                        Margin="10" />
                </StackPanel>
            </md:DrawerHost.RightDrawerContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
                    <TextBox
                        Width="140"
                        Margin="20,10,20,10"
                        md:HintAssist.Hint="查找代办事项..."
                        md:TextFieldAssist.HasClearButton="True"
                        FontSize="15"
                        Foreground="Gray" />
                    <TextBlock
                        Text="筛选:"
                        Margin="30,20,20,10"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White" />
                    <ComboBox
                        VerticalAlignment="Center"
                        SelectedIndex="0"
                        FontSize="14"
                        Foreground="White">
                        <ComboBoxItem>全部</ComboBoxItem>
                        <ComboBoxItem>代办</ComboBoxItem>
                        <ComboBoxItem>已完成</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <Button
                    Content="添加代办事项"
                    Command="{Binding AddTodoItemCommand}"
                    HorizontalAlignment="Right" />
                <ItemsControl Grid.Row="1"
                    ItemsSource="{Binding TodoItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel>
                            </WrapPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="10"
                                Background="DarkGreen"
                                CornerRadius="5">
                                <Grid
                                    Width="130"
                                    Height="130">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="100" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                        Text="{Binding Title}"
                                        Margin="0,10"
                                        FontWeight="Bold"
                                        Foreground="White" />
                                    <md:PopupBox HorizontalAlignment="Right">
                                        <Button
                                            Content="删除"
                                            Background="Red"
                                            Foreground="White" />
                                    </md:PopupBox>

                                    <TextBlock Grid.Row="1"
                                        Text="{Binding Description}"
                                        Margin="0,0,20,0"
                                        Foreground="White" />
                                    <Canvas
                                        Grid.RowSpan="2"
                                        ClipToBounds="True">
                                        <Border
                                            Canvas.Top="20"
                                            Canvas.Right="-50"
                                            Width="100"
                                            Height="100"
                                            CornerRadius="100"
                                            Background="#ffff"
                                            Opacity="0.1" />
                                        <Border
                                            Canvas.Top="50"
                                            Canvas.Right="-30"
                                            Width="100"
                                            Height="100"
                                            CornerRadius="100"
                                            Background="#ffff"
                                            Opacity="0.1" />
                                    </Canvas>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </md:DrawerHost>
    </md:DialogHost>

</UserControl>

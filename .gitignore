# ======================== .NET WPF 核心忽略规则 ========================
# 1. Visual Studio 核心缓存/配置文件
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/                  # VS 隐藏目录（包含缓存、索引、布局配置）
.idea/                # Rider 配置目录
*.sln.iml             # Rider 解决方案索引
.cr/                  # CodeRush 插件配置

# 2. 编译输出目录（WPF 项目编译产物）
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/              # 发布目录
bld/                  # 临时构建目录

# 3. WPF 本地配置/调试文件
**/Properties/launchSettings.json  # 本地启动配置（端口、环境等）
appsettings*.Local.json            # 本地环境配置（不提交到仓库）
appsettings*.Development.json      # 开发环境配置（可选忽略）
*.vshost.exe                       # VS 调试宿主程序
*.vshost.exe.config
*.vshost.exe.manifest

# 4. NuGet 相关（包缓存不提交）
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/             # 保留 build 目录（MSBuild 依赖）
project.lock.json
project.assets.json
paket-files/
.paket/

# 5. 测试/覆盖率文件
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage                         # 代码覆盖率文件
*.runsettings                      # 本地测试配置

# 6. 临时/备份文件
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
*.bak
*.tmp
*.cache
*.log

# 7. WPF 设计时/生成文件
Generated_Code/                    # 自动生成的代码（如 WCF 服务引用）
*.g.cs                             # WPF 界面自动生成代码（正常会被排除，兜底）
*.g.i.cs
DesignTimeBuild/                   # 设计时构建缓存
FileContentIndex/                  # VS 文件索引

# 8. 大型资源/无关文件
*.zip
*.rar
*.7z
*.mp4
*.avi
*.png.bak                          # 图片备份
*.xaml.bak                         # XAML 备份文件

# 9. 第三方工具/插件文件
# GitHub Copilot
.vs/*/CopilotIndices/
# GhostDoc
*.GhostDoc.xml
# Resharper
_ReSharper*/
*.DotSettings.user
# StyleCop
StyleCop.Cache
# NCrunch
*_ncrunch_*
*.ncrunchproject
# Fakes
FakesAssemblies/

# 10. 系统/临时文件
.DS_Store                          # Mac 系统文件
Thumbs.db                          # Windows 缩略图缓存
desktop.ini                        # Windows 文件夹配置